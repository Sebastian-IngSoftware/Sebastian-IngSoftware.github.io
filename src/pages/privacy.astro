---
import Layout from "@/layouts/Layout.astro";

const updated = "Noviembre 2026";

const sections = [
  {
    title: "Información general",
    body: "Este sitio es mi portafolio personal y tiene fines informativos. No es una tienda ni presta servicios a través de la web.",
  },
  {
    title: "Cookies y seguimiento",
    body: "No utilizo cookies de seguimiento. Tampoco hay píxeles publicitarios ni scripts de terceros con fines de marketing.",
  },
  {
    title: "Datos personales",
    body: "No solicito registro, no pido contraseñas y no recopilo datos personales de los visitantes. Puedes navegar por el sitio de forma anónima.",
  },
  {
    title: "Enlaces externos",
    body: "El sitio incluye enlaces a plataformas como GitHub, LinkedIn y WhatsApp. Al hacer clic pasas a sitios con sus propias políticas de privacidad, sobre las que no tengo control.",
  },
  {
    title: "Correo electrónico",
    body: "Si me escribes por correo, usaré tu información únicamente para responderte y no la compartiré con terceros.",
  },
];
---

<Layout title="Política de privacidad | Sebastian Sarmiento">
  <section class="py-14 sm:py-16" aria-labelledby="privacy-title">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <header class="max-w-2xl mx-auto text-center">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-border/70 bg-surface px-3 py-1 text-xs font-semibold uppercase tracking-wider text-accent"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          Legal
        </span>

        <h1
          id="privacy-title"
          class="mt-4 mb-0 text-3xl sm:text-4xl md:text-5xl font-bold"
        >
          Política de <span class="text-accent">privacidad</span>
        </h1>

        <p class="mt-3 mb-0 text-text-muted leading-relaxed">
          Tu privacidad me importa. Aquí te explico de forma clara qué datos se
          tratan cuando visitas este sitio.
        </p>

        <p class="mt-2 mb-0 text-sm text-text-muted">
          Última actualización: {updated}
        </p>
      </header>

      <div class="mt-10 sm:mt-12 flex flex-col gap-4">
        {
          sections.map((section, index) => (
            <article class="rounded-xl border border-border/70 bg-surface p-5 sm:p-6 transition-colors hover:border-accent/60">
              <div class="flex items-start gap-4">
                <span
                  class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-tertiary/50 text-sm font-bold text-accent"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div class="min-w-0">
                  <h2 class="m-0 text-lg sm:text-xl font-semibold text-success">
                    {section.title}
                  </h2>
                  <p class="mt-2 mb-0 text-text-muted leading-relaxed">
                    {section.body}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div
        class="mt-8 sm:mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between rounded-xl border border-border/70 bg-surface p-5 sm:p-6 border-l-4 border-l-success"
      >
        <div class="min-w-0">
          <h2 class="m-0 text-lg font-semibold text-text">
            ¿Tienes alguna duda?
          </h2>
          <p class="mt-1 mb-0 text-sm text-text-muted">
            Escríbeme y te responderé lo antes posible.
          </p>
        </div>

        <a
          href="mailto:sebastiansarmientocas@gmail.com"
          class="shrink-0 inline-flex items-center justify-center gap-2 rounded-lg border-2 border-accent bg-accent px-4 py-2 font-bold text-background no-underline transition-all duration-300 hover:bg-transparent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <svg
            class="h-4 w-4 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M4 4h16v16H4V4zm0 0l8 8 8-8" />
          </svg>
          <span class="truncate">Contacto</span>
        </a>
      </div>

      <div class="mt-8 flex justify-center">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-text-muted no-underline transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M19 12H5m7-7-7 7 7 7" />
          </svg>
          Volver al inicio
        </a>
      </div>
    </div>
  </section>
</Layout>
